#!/usr/bin/env bash
# Run Comskip in Docker as if it were installed here.
#
# Usage: comskip-docker [COMSKIP ARGUMENTS...]
#
# Takes the same arguments as comskip. The current folder, every folder named
# in the arguments, and the folder of every file named in them (values such as
# --ini=FILE included), are shared with the container at the same paths, so the
# paths in the arguments work unchanged and Comskip writes its output where it
# would if it ran here. Comskip runs in the current folder, without network
# access.
#
# Build its image first: see docs/installing-comskip-and-join-logo-scp.md.
set -euo pipefail

image=tv-commercial-detector/comskip

# Stop with Docker's own reason if Docker isn't running or the image isn't built.
if ! reason=$(docker image inspect "$image" 2>&1 >/dev/null); then
  echo "comskip-docker: can't use the $image image: ${reason%%$'\n'*}" >&2
  exit 1
fi

folders=("$PWD")
for argument in "$@"; do
  path=${argument#--*=}
  if [[ -d $path ]]; then
    folder=$(cd "$path" && pwd)
  elif [[ -e $path ]]; then
    folder=$(cd "$(dirname "$path")" && pwd)
  else
    continue
  fi
  listed=no
  for known in "${folders[@]}"; do
    [[ $known == "$folder" ]] && listed=yes
  done
  [[ $listed == yes ]] || folders+=("$folder")
done

volumes=()
for folder in "${folders[@]}"; do
  volumes+=(--volume "$folder:$folder")
done

exec docker run --rm --init --pull never --network none \
  --user "$(id -u):$(id -g)" \
  "${volumes[@]}" \
  --workdir "$PWD" \
  "$image" "$@"
